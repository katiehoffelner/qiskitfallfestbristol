---
import '../styles/globals.css'
import { siteConfig } from '../config/site.config'
import LandingSection from './LandingSection.astro'
import ContactIntro from './ContactIntro.astro'
import Input from './Input.astro'
import Textarea from './Textarea.astro'
import Select from './Select.astro'
import Button from './Button.astro'

const { contact, forms } = siteConfig
const rawContactAction = forms?.contactAction?.trim() ?? ''
const contactAccessKey = forms?.contactAccessKey?.trim() ?? ''
const contactNetlify = forms?.contactNetlify ?? false
const contactFormAction =
  rawContactAction.length > 0 ? rawContactAction : contactNetlify ? '/' : undefined
const contactDemoOnly = !rawContactAction && !contactNetlify
const contactViaFetch = !contactNetlify && contactAccessKey.length > 0
---

<LandingSection id="contact" class="section ac-section-band--subtle">
  <div class="ac-contact">
    <div class="ac-contact__layout animate-fade-in-up">
    <ContactIntro
      badge={contact.badge}
      title={contact.title}
      description={contact.description}
      channels={contact.channels}
    />

    <div class="ac-contact__form-wrap">
      <form
        class="ac-contact__form"
        data-contact-form
        {...contactDemoOnly ? { 'data-demo-only': '' } : {}}
        {...contactViaFetch ? { 'data-fetch-submit': '' } : {}}
        action={contactFormAction}
        method={contactFormAction !== undefined || contactNetlify ? 'POST' : undefined}
        {...contactNetlify
          ? { 'data-netlify': 'true', name: 'contact' }
          : {}}
      >
        {contactAccessKey && (
          <input type="hidden" name="access_key" value={contactAccessKey} />
        )}
        {contactAccessKey && (
          <input type="hidden" name="subject" value={`New enquiry — ${contact.title}`} />
        )}
        {contactAccessKey && (
          <input type="checkbox" name="botcheck" class="ac-contact__honeypot" tabindex="-1" autocomplete="off" />
        )}

        <div class="ac-contact__row">
          <Input label="First name" placeholder="Alice" name="firstName" required />
          <Input label="Last name" placeholder="Bob" name="lastName" required />
        </div>

        <Input
          label="Email"
          type="email"
          placeholder="alice.bob@company.com"
          name="email"
          required
        />

        <Select label="Topic" name="topic" options={contact.topics} />

        <Textarea
          label="Message"
          placeholder="Tell us how we can help…"
          name="message"
          rows={5}
          required
        />

        <Button type="submit" label={contact.cta} variant="primary" />

        <p class="ac-contact__status" data-contact-status role="status" aria-live="polite"></p>

        <p class="ac-contact__privacy">
          By submitting you agree to our <a href="/privacy">Privacy Policy</a>.
        </p>
      </form>
    </div>
  </div>
  </div>
</LandingSection>

<style>
  .ac-contact__layout {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--ac-spacing-20);
    align-items: start;
  }

  .ac-contact__form-wrap {
    background: var(--ac-card-bg);
    border: 0.0625rem solid var(--ac-border-color);
    border-radius: var(--ac-rounded-2xl);
    padding: var(--ac-spacing-10);
    box-shadow: var(--ac-shadow-lg);
  }

  .ac-contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--ac-spacing-5);
  }

  .ac-contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ac-spacing-4);
  }

  .ac-contact__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .ac-contact__status {
    margin: 0;
    font-size: var(--ac-text-sm);
    text-align: center;
    min-height: 0;
  }

  .ac-contact__status[data-state='error'] {
    color: var(--ac-error, #e5484d);
  }

  .ac-contact__status[data-state='success'] {
    color: var(--ac-success, #2fb344);
  }

  .ac-contact__privacy {
    font-size: var(--ac-text-xs);
    color: var(--ac-text-muted);
    text-align: center;
  }

  .ac-contact__privacy a {
    color: rgb(var(--ac-primary));
    text-decoration: none;
  }

  .ac-contact__privacy a:hover {
    text-decoration: underline;
  }

  @media (max-width: 56.25rem) {
    .ac-contact__layout {
      grid-template-columns: 1fr;
      gap: var(--ac-spacing-12);
    }
  }

  @media (max-width: 30rem) {
    .ac-contact__row {
      grid-template-columns: 1fr;
    }

    .ac-contact__form-wrap {
      padding: var(--ac-spacing-6);
    }
  }
</style>

<script>
  const form = document.querySelector('[data-contact-form]') as HTMLFormElement | null
  const btn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null
  const status = form?.querySelector('[data-contact-status]') as HTMLParagraphElement | null
  const originalLabel = btn?.textContent ?? ''

  form?.addEventListener('submit', async (e) => {
    if (form.hasAttribute('data-demo-only')) {
      e.preventDefault()
      if (btn) {
        btn.textContent = 'Message sent!'
        btn.disabled = true
      }
      return
    }

    if (!form.hasAttribute('data-fetch-submit')) return
    e.preventDefault()

    if (btn) {
      btn.disabled = true
      btn.textContent = 'Sending…'
    }
    if (status) {
      status.textContent = ''
      status.removeAttribute('data-state')
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      })
      const result = await response.json()

      if (result.success) {
        form.reset()
        if (btn) btn.textContent = 'Message sent!'
        if (status) {
          status.textContent = "Thanks, we'll get back to you soon!"
          status.setAttribute('data-state', 'success')
        }
      } else {
        throw new Error(result.message || 'Submission failed')
      }
    } catch {
      if (btn) {
        btn.disabled = false
        btn.textContent = originalLabel
      }
      if (status) {
        status.textContent = 'Something went wrong, please try again, or email us directly.'
        status.setAttribute('data-state', 'error')
      }
    }
  })
</script>
