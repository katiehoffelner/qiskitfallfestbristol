---
import '../styles/globals.css'
import { siteConfig } from '../config/site.config'
import { logoCloudSvgPaths } from '../data/logocloud-logo-paths'
import LandingSection from './LandingSection.astro'

const { logocloud } = siteConfig
---

<LandingSection class="section ac-section-dividers-y" containerClass="animate-fade-in-up">
  <div class="ac-logocloud">
    <p class="ac-logocloud__label">{logocloud.title}</p>

    <div class="ac-logocloud__row">
      {logocloud.logos.map((logo) => {
        const svg = logoCloudSvgPaths[logo.id]
        const Icon = svg?.component
        return (
          <div class="ac-logocloud__item" title={logo.name}>
            {Icon ? (
              <Icon class="ac-logocloud__icon" fill="currentColor" />
            ) : svg?.path ? (
              <svg
                class="ac-logocloud__icon"
                viewBox={svg.viewBox ?? '0 0 24 24'}
                xmlns="http://www.w3.org/2000/svg"
                fill="currentColor"
                aria-label={logo.name}
                set:html={svg.path}
              ></svg>
            ) : (
              <span class="ac-logocloud__text">{logo.name}</span>
            )}
          </div>
        )
      })}
    </div>
  </div>
</LandingSection>

<style>
  .ac-logocloud {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ac-spacing-10);
  }

  .ac-logocloud__label {
    font-size: var(--ac-text-xs);
    font-weight: var(--ac-font-semibold);
    color: var(--ac-text-muted);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .ac-logocloud__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--ac-spacing-4) var(--ac-spacing-12);
  }

  .ac-logocloud__item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3rem;
    opacity: 0.7;
    transition: opacity 0.25s ease, transform 0.25s ease;
    color: var(--ac-text);
  }

  .ac-logocloud__item:hover {
    opacity: 1;
    transform: translateY(-0.125rem);
  }

  .ac-logocloud__icon {
    height: 100%;
    width: auto;
    max-width: 14rem;
  }

  .ac-logocloud__text {
    font-size: var(--ac-text-lg);
    font-weight: var(--ac-font-bold);
    color: var(--ac-text);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .ac-logocloud__row {
      gap: var(--ac-spacing-4) var(--ac-spacing-8);
    }

    .ac-logocloud__item {
      height: 2.5rem;
    }
  }
</style>
