---
import Layout from '../layouts/Layout.astro'
import { siteConfig } from '../config/site.config'

const title = `Privacy Policy — ${siteConfig.brand.name}`
const description = `How ${siteConfig.brand.name} collects, uses, and protects your personal information.`

const updated = 'September 8, 2026'
---

<Layout title={title} description={description}>
  <article class="ac-legal">
    <header class="ac-legal__header">
      <h1 class="ac-legal__title">Privacy Policy</h1>
      <p class="ac-legal__meta">
        Last updated: <time datetime="2026-09-08">{updated}</time>
      </p>
    </header>

    <div class="ac-legal__body">
      <section class="ac-legal__section" aria-labelledby="legal-intro">
        <h2 id="legal-intro">Introduction</h2>
        <p>
          {siteConfig.brand.name} (&quot;we&quot;, &quot;us&quot;, or &quot;our&quot;) is a student-run event at the
          University of Bristol. This policy describes how we handle information when you use this website.
        </p>
      </section>

      <section class="ac-legal__section" aria-labelledby="legal-collect">
        <h2 id="legal-collect">Information we collect</h2>
        <p>
          If you use the contact form on this site, we collect the name, email address, and message you submit,
          so that we can reply to you. The form is processed by <a href="https://web3forms.com" target="_blank" rel="noopener noreferrer">Web3Forms</a>,
          which delivers your message directly to our inbox and does not store your submission itself. Event registration
          and community discussion happen on EventBrite and Discord, which have their own privacy policies.
        </p>
      </section>

      <section class="ac-legal__section" aria-labelledby="legal-cookies">
        <h2 id="legal-cookies">Cookies and analytics</h2>
        <p>
          This site does not use tracking or advertising cookies. We remember your light/dark theme preference in
          your browser's local storage only, it is never sent to us. We use Umami, a privacy-friendly,
          cookieless analytics tool, to see aggregate visit counts; it does not track you individually across
          sites.
        </p>
      </section>

      <section class="ac-legal__section" aria-labelledby="legal-sharing">
        <h2 id="legal-sharing">Sharing</h2>
        <p>
          We do not sell your information. Contact form submissions pass through Web3Forms solely to reach our
          inbox. This site is hosted on GitHub Pages, whose own privacy practices apply to how pages are served
          to you.
        </p>
      </section>

      <section class="ac-legal__section" aria-labelledby="legal-rights">
        <h2 id="legal-rights">Your rights and choices</h2>
        <p>
          You can ask us to access, correct, or delete any information you've sent us via the contact form at
          any time, just get in touch using the contact details on this site.
        </p>
      </section>

      <section class="ac-legal__section" aria-labelledby="legal-changes">
        <h2 id="legal-changes">Changes to this policy</h2>
        <p>
          We may update this policy from time to time. We will post the new version on this page and adjust the
          &quot;Last updated&quot; date.
        </p>
      </section>

      <section class="ac-legal__section" aria-labelledby="legal-contact">
        <h2 id="legal-contact">Contact</h2>
        <p>
          Questions about this policy: use the contact options on our website.
        </p>
      </section>
    </div>
  </article>
</Layout>

<style>
  .ac-legal {
    max-width: 42rem;
    margin: 0 auto;
    padding: var(--ac-spacing-12) var(--ac-container-padding) var(--ac-spacing-24);
  }

  .ac-legal__header {
    margin-bottom: var(--ac-spacing-10);
    padding-bottom: var(--ac-spacing-8);
    border-bottom: var(--ac-border) solid var(--ac-border-color);
  }

  .ac-legal__title {
    font-size: var(--ac-text-4xl);
    font-weight: var(--ac-font-bold);
    line-height: var(--ac-leading-tight);
    color: var(--ac-text);
    margin: 0 0 var(--ac-spacing-3);
  }

  .ac-legal__meta {
    margin: 0;
    font-size: var(--ac-text-sm);
    color: var(--ac-text-muted);
  }

  .ac-legal__body {
    display: flex;
    flex-direction: column;
    gap: var(--ac-spacing-10);
    font-size: var(--ac-text-md);
    line-height: var(--ac-leading-relaxed);
    color: var(--ac-text);
  }

  .ac-legal__notice {
    margin: 0;
    padding: var(--ac-spacing-4) var(--ac-spacing-5);
    border-radius: var(--ac-rounded-xl);
    background: var(--ac-bg-subtle);
    border: var(--ac-border) solid var(--ac-border-color);
    font-size: var(--ac-text-sm);
    color: var(--ac-text-muted);
  }

  .ac-legal__section h2 {
    font-size: var(--ac-text-xl);
    font-weight: var(--ac-font-bold);
    color: var(--ac-text);
    margin: 0 0 var(--ac-spacing-4);
    line-height: var(--ac-leading-tight);
  }

  .ac-legal__section p {
    margin: 0 0 var(--ac-spacing-4);
  }

  .ac-legal__section p:last-child {
    margin-bottom: 0;
  }

  .ac-legal__section ul {
    margin: 0 0 var(--ac-spacing-4);
    padding-left: var(--ac-spacing-6);
    display: flex;
    flex-direction: column;
    gap: var(--ac-spacing-3);
    color: var(--ac-text-muted);
  }

  .ac-legal__section li strong {
    color: var(--ac-text);
    font-weight: var(--ac-font-semibold);
  }

  .ac-legal__section:last-child p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 48rem) {
    .ac-legal__title {
      font-size: var(--ac-text-3xl);
    }
  }
</style>
